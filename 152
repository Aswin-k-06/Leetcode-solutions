class Solution {
    int min1(int a,int b){
        if(a<b){
            return a;
        }
        return b;
    }
    int max1(int a,int b){
        if(a>b){
            return a;
        }
        return b;
    }
    
    public int maxProduct(int[] nums) {
        int max=nums[0];
        int min=nums[0];
        int ans=nums[0];
        for(int i=1;i<nums.length;i++){
            int v1=nums[i];
            int v2=nums[i]*max;
            int v3=nums[i]*min;
            min=min1(v1,min1(v2,v3));
            max=max1(v1,max1(v2,v3));
            ans=max1(max,ans);
        }
        return ans;
    }
}
