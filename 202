class Solution {
    public int f(int n){
        int d;
        int sum=0;
        while(n>0){
            d=n%10;
            n=n/10;
            sum=sum+d*d;
        }
        return sum;
    }
    public boolean isHappy(int n) {
        int slow=n;
        int fast=n;
        while(fast!=1){
            slow=f(slow);
            fast=f(fast);
            fast=f(fast);
            if(slow==fast && slow!=1){
                return false;
            }
        }
        return true;
    }
}
