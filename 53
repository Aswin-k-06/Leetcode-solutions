class Solution {
    int max(int a, int b){
        if(a>b){
            return a;
        }
        return b;
    }
    public int maxSubArray(int[] nums) {
        int best=nums[0];
        int sum=nums[0];
        int v1,v2;
        for(int i=1;i<nums.length;i++){
            v1=nums[i];
            v2=best+nums[i]; 
            best=max(v1,v2);
            sum=max(best,sum);
        }
        return sum;
    }
}
