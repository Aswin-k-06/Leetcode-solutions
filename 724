class Solution {
    public int pivotIndex(int[] n) {
        int sum=0,left=0,right=0;
        for(int i=0;i<n.length;i++){
            sum+=n[i];
        }
        for(int j=0;j<n.length;j++){
            if(j!=0){
                left+=n[j-1];
            }
            right=sum-left-n[j];
            if(left==right){
                return j;
            }
        }
          return -1;
    }

}
